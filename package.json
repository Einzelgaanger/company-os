{
  "name": "loop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Loop — autonomous work-coordination agent. See docs/README.md.",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @loop/api dev",
    "dev:workers": "pnpm --filter @loop/workers dev",
    "dev:webhooks": "pnpm --filter @loop/webhooks dev",
    "dev:scheduler": "pnpm --filter @loop/scheduler dev",
    "build": "tsc && vite build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run typecheck",
    "build:apps": "pnpm --filter @loop/api build && pnpm --filter @loop/workers build && pnpm --filter @loop/webhooks build && pnpm --filter @loop/scheduler build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node scripts/seed/demo.mjs",
    "ops:twilio-secrets": "node scripts/ops/set-twilio-secrets.mjs",
    "ops:whatsapp-secrets": "node scripts/ops/set-whatsapp-secrets.mjs",
    "ops:meta-webhook-subscribe": "node scripts/ops/meta-webhook-subscribe.mjs",
    "ops:meta-app-webhook-fix": "node scripts/ops/meta-app-webhook-fix.mjs",
    "ops:openrouter-secret": "node scripts/ops/set-openrouter-secret.mjs",
    "ops:supabase-migrate": "node scripts/ops/apply-supabase-migration.mjs",
    "smoke:prod": "node scripts/smoke/prod.mjs",
    "smoke:whatsapp": "node scripts/smoke/whatsapp-readiness.mjs",
    "smoke:api": "node scripts/smoke/offline-api.mjs",
    "typecheck:packages": "pnpm --filter @loop/shared typecheck && pnpm --filter @loop/db typecheck && pnpm --filter @loop/ai typecheck && pnpm --filter @loop/messaging typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:packages && pnpm --filter @loop/api typecheck && pnpm --filter @loop/workers typecheck && pnpm --filter @loop/webhooks typecheck && pnpm --filter @loop/scheduler typecheck",
    "test:ui": "vitest run",
    "test:db": "pnpm --filter @loop/db test",
    "test:shared": "pnpm --filter @loop/shared test",
    "test:messaging": "pnpm --filter @loop/messaging test",
    "test:ai": "pnpm --filter @loop/ai test",
    "test:api": "pnpm --filter @loop/api test",
    "test:workers": "pnpm --filter @loop/workers test",
    "test:webhooks": "pnpm --filter @loop/webhooks test",
    "test:packages": "pnpm test:shared && pnpm test:messaging && pnpm test:ai && pnpm test:api && pnpm test:db && pnpm test:workers && pnpm test:webhooks",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "node scripts/ops/db-migrate.mjs",
    "db:reset": "docker compose down -v && pnpm db:up && node -e \"setTimeout(()=>{},4000)\" && pnpm db:migrate",
    "check:rls": "node scripts/checks/rls.mjs",
    "check:no-body-tenant": "node scripts/checks/no-body-tenant.mjs",
    "check:no-org-id": "node scripts/checks/no-org-id.mjs",
    "check:tokens": "node scripts/checks/tokens.mjs",
    "eval:ai": "pnpm --filter @loop/ai eval",
    "ci:gates": "pnpm check:rls && pnpm check:no-body-tenant && pnpm check:no-org-id && pnpm check:tokens && pnpm test:ui && pnpm test:packages && pnpm eval:ai && npm run build && pnpm build:apps && pnpm typecheck:all"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
