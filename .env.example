# api_key connectors (Gong, Trello, Sentry, Datadog, Stripe, Greenhouse, Personio,
# Mixpanel, Amplitude, Segment, SendGrid, Coda, Shortcut, Loom, WorkOS, Telegram,
# WhatsApp, Twilio) take their credential from an admin on /integrations and store
# it encrypted. Webhook connectors (Fathom, Zapier, Make, n8n) mint their own URL
# and signing secret. Neither needs an entry here.
# Inbound webhook host used in the URLs Company OS hands out:
WEBHOOKS_PUBLIC_URL=http://127.0.0.1:3002

