VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://companyos.jabali.studio

# Demo-only local/mock — do NOT set on Render
VITE_ALLOW_MOCK=

# Leave empty on Render (Supabase is the data plane). Local Fastify only:
