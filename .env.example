VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://company-os-cce2.onrender.com

# Demo-only — do NOT set in production
VITE_ALLOW_MOCK=

# Optional Fastify API data plane (monorepo stack)
VITE_API_URL=http://127.0.0.1:3001

