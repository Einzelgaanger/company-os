# ---- Frontend (Vite) ----
# Leave blank to run Loop in local mock mode (seeded demo data, no backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Fastify API for SPA client (preferred data plane)
VITE_API_URL=http://127.0.0.1:3001

# ---- Fastify API (A0 — required; no fallbacks) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://loop_app:loop@127.0.0.1:5433/loop
DATABASE_OWNER_URL=postgres://loop_owner:loop@127.0.0.1:5433/loop
REDIS_URL=redis://127.0.0.1:6380
APP_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:3001
# AES-256 key for OAuth token envelope encryption (64 hex chars or any secret)
TOKEN_ENCRYPTION_KEY=
# Optional alias — hashed to 32 bytes if TOKEN_ENCRYPTION_KEY unset
KMS_KEY_ID=

# ---- Webhooks (A0 — missing secret → 503; no unsigned path) ----
TWILIO_AUTH_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
FATHOM_WEBHOOK_SECRET=
MESSAGING_NUMBERS_PATH=.data/messaging-numbers.json
DEV_WEBHOOK_TENANT_ID=
MESSAGING_MODE=in_app
FEATURE_WHATSAPP_MANUAL_APPROVE=true
FEATURE_EMAIL_INGESTION=false

# ---- Twilio WhatsApp (live mode) ----
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_NUMBER=
META_WABA_ID=

# ---- OAuth connectors (calendar; email gated) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- WorkOS SSO / SCIM ----
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=

# ---- Reports / PDF storage ----
REPORT_PDF_DIR=.data/reports
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
REPORT_FROM_ADDRESS=

# ---- Optional AI ----
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
FATHOM_API_KEY=
